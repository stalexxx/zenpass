# Copy to infra/.env.production and replace every <...> value before startup.
# This file contains intentionally fake values only. Do not commit the copy.

# Reverse-proxy hostname. DNS for this name must point to <VPS_IP> before Caddy starts.
# If you have no domain yet, set this to the bare VPS IP and also set
# CADDY_TLS_DIRECTIVE=tls internal below.
DOMAIN=<DOMAIN>

# Leave empty for a real DOMAIN (Caddy issues a public Let's Encrypt cert
# automatically). Set to "tls internal" when DOMAIN is a bare IP address, so
# Caddy issues a local self-signed cert instead (browsers will warn about an
# untrusted certificate — acceptable for personal/internal use only).
CADDY_TLS_DIRECTIVE=

# PostgreSQL container initialization and the API connection URL. Use URL-safe
# credentials (or percent-encode reserved URL characters in DATABASE_URL).
POSTGRES_DB=zkpm
POSTGRES_USER=zkpm
POSTGRES_PASSWORD=<GENERATE_A_LONG_RANDOM_POSTGRES_PASSWORD>
DATABASE_URL=postgres://zkpm:<GENERATE_A_LONG_RANDOM_POSTGRES_PASSWORD>@postgres:5432/zkpm
DATABASE_SSL=false

# API listener (only reachable by the Caddy container) and browser allowlist.
PORT=3000
HOST=0.0.0.0
WEB_ORIGIN=https://<DOMAIN>
LOG_LEVEL=info

# Required in production. Generate a new base64 value exactly once for a new
# deployment and retain it securely: replacing it makes existing OPAQUE
# credentials unusable. Never paste a real value into this example file.
OPAQUE_SERVER_SETUP=<GENERATE_AND_STORE_A_BASE64_OPAQUE_SERVER_SETUP>

# Authentication policy values (seconds / requests).
SESSION_TTL_SECONDS=900
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
