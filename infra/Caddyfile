# CADDY_SITE_ADDRESS is the Caddyfile site address Caddy actually binds to.
# CADDY_TLS_DIRECTIVE selects the certificate source. Two supported shapes:
#   - Real domain: CADDY_SITE_ADDRESS=<same value as DOMAIN>,
#     CADDY_TLS_DIRECTIVE=<empty>. Caddy's automatic HTTPS obtains a public
#     Let's Encrypt cert for that hostname via SNI.
#   - Bare IP, no domain yet: CADDY_SITE_ADDRESS=:443, CADDY_TLS_DIRECTIVE=
#     "tls internal". A real HTTP client does not send SNI for a literal IP
#     address (RFC 6066), so the site address must NOT be host-restricted —
#     ":443" matches every connection on that port regardless of SNI. Caddy's
#     local/internal CA issues a self-signed cert; browsers will show an
#     untrusted-certificate warning. Acceptable for personal/internal use
#     only, not for public release.
# Caddy's reverse_proxy does not log request bodies. No access-log block is
# configured here, so encrypted request payloads are not recorded by Caddy.
{$CADDY_SITE_ADDRESS} {
	encode zstd gzip
	{$CADDY_TLS_DIRECTIVE}

	reverse_proxy api:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
