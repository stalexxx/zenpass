{
  "name": "zero-knowledge-password-manager",
  "private": true,
  "packageManager": "bun@1.2.15",
  "engines": { "bun": ">=1.2.15" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "bun run --filter '*' --if-present build && cargo build --workspace",
    "test": "bun run --filter '*' --if-present test && cargo test --workspace",
    "lint": "bun run --filter '*' --if-present lint && cargo fmt --all -- --check",
    "check:boundaries": "bun scripts/check-boundaries.mjs"
  }
}
