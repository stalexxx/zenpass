<network-security-config>
    <!-- Production/base config: system CAs only, matching
         android:usesCleartextTraffic="false" in the manifest. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- D02-MVP manual on-emulator evidence run only: trusts one fixed,
         checked-in, throwaway self-signed certificate
         (apps/android/demo-fixture/demo-cert.pem/-key.pem, 127.0.0.1-only,
         10-year validity, private key never shipped in the app), scoped
         strictly to the loopback domain "127.0.0.1" via <domain-config> so
         it can never be presented by, or extend trust to, any other host
         — this is not a debug/production distinction, it's a fixed
         additional trust anchor for one specific test/demo hostname only.
         Generated solely for apps/android/scripts/manual-emulator-fixture.mjs,
         which fronts the real backend with this certificate so the actual
         Android app can perform a real on-device TLS handshake against it
         without any on-device "install a CA certificate" step (that flow
         requires a device credential and, on this API level's scoped
         storage, could not even read a pushed certificate file — see this
         task's completion report for what was tried before landing here). -->
    <domain-config>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/demo_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
